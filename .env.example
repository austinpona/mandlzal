# Copy to .env and fill in
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mandlzi
# For local dev without Postgres you can use SQLite:
# DATABASE_URL=sqlite:///./mandlzi.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Set to 1 in production. Triggers strict boot-time checks:
#  * refuses to start if JWT_SECRET is the default placeholder
#  * refuses to start if JWT_SECRET is shorter than 32 chars
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PRODUCTION=0

# Rate limiting (slowapi). 0 to disable entirely (e.g. in tests).
RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute

# Observability
REQUEST_LOG_ENABLED=1
METRICS_ENABLED=1
# Put /metrics behind admin auth (default: open, like most internal scrapers).
METRICS_REQUIRE_ADMIN=0

# Business rules (defaults; can be overridden per policy in DB)
GRACE_PERIOD_DAYS=30
LAPSE_THRESHOLD_MONTHS=3

# Schema bootstrap: 1 = call Base.metadata.create_all on startup (dev),
# 0 = disabled; use `alembic upgrade head` instead (production).
RUN_INIT_DB=1

# Daily billing sweep (APScheduler). Disable in tests or multi-replica
# setups without a shared lock.
SCHEDULER_ENABLED=1
SWEEP_HOUR_UTC=2
SWEEP_MINUTE_UTC=0

# Notification delivery. "log" = write to app log; "webhook" = POST JSON.
NOTIFICATION_PROVIDER=log
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_DISPATCH_INTERVAL_MINUTES=5
NOTIFICATION_MAX_ATTEMPTS=5

# RBAC roles: admin, agent, viewer.
#  - The first user to register becomes `admin`. All subsequent
#    self-registrations default to `viewer` (read-only). Promote users
#    via `PATCH /auth/users/{id}/role` as an admin.
#  - `is_admin` on the User model is automatically kept in sync with
#    `role == admin` for back-compat.
